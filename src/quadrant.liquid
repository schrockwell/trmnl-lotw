<div class="layout layout--col layout--center">
  {% if error != blank %}
  <div class="item">
    <div class="meta"></div>
    <div class="content">
      <span class="title title--small">LOTW unreachable</span>
    </div>
  </div>
  {% else %}
  <div class="item">
    <div class="meta"></div>
    <div class="content">
      <span class="value value--xlarge value--tnums" data-value-type="number">{{ stats.confirmations | default: 0 }}</span>
      <span class="label">QSLs · {{ period_label }}</span>
    </div>
  </div>
  <span class="label label--small">{{ stats.entities | default: 0 }} entities · {{ stats.band_slots | default: 0 }} band-slots{% if last_qsl_date != blank %} · last {{ last_qsl_date }}{% endif %}</span>
  {% endif %}
</div>

<div class="title_bar">
  <img class="image" src="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2' stroke-linecap='round'><rect x='7' y='3' width='14' height='18' rx='2'/><path d='M11 8h6M11 12h6M11 16h6'/><path d='M4 6h5M4 10h5M4 14h5M4 18h5'/></svg>">
  <span class="title">{{ account_call }} LOTW</span>
</div>